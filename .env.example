# Провайдер LLM: yandexgpt | openai_compatible
LLM_PROVIDER=yandexgpt

# --- YandexGPT ---
YC_FOLDER_ID=your_folder_id
YC_API_KEY=your_api_key
# YC_IAM_TOKEN=your_iam_token
# YC_MODEL=yandexgpt

# --- OpenAI-совместимый ---
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

# Общие
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2000
LLM_TIMEOUT=60
LLM_MAX_RETRIES=3
